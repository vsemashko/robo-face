# Server Configuration
PORT=3000
NODE_ENV=development

# Character Configuration
CHARACTER=robo-face
DEFAULT_STATE=idle

# Animation Configuration
TARGET_FPS=30
ANIMATION_SPEED=1.0

# Event Configuration
EVENT_QUEUE_SIZE=10
DEFAULT_ANIMATION_DURATION=3000

# Logging
LOG_LEVEL=info

# Optional: MQTT Configuration
MQTT_ENABLED=false
MQTT_BROKER=mqtt://localhost:1883
MQTT_TOPIC=robo-face/event

# Optional: GPIO Configuration
GPIO_ENABLED=false
